<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 demands a doc comment on every public member, which turns a
         self-explanatory property into a line restating its own name. Types and
         anything with a real caveat are documented; the rest are not. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>IronEye</PackageId>
    <Version>1.0.0</Version>
    <Authors>Direct Softworks</Authors>
    <Description>Official .NET client for the IronEye document intelligence and collection API.</Description>
    <PackageProjectUrl>https://ironeye.org/docs/sdk/dotnet</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/IronEyeAPI/ironeye-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The README is what nuget.org renders on the package page. Without it
         the listing is a one-line description and a version number, which is
         the first thing a reader sees and the last thing that persuades them. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ironeye;document-intelligence;pii;ocr;invoice;api-client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The abstraction only. A client library that pulls in a logging
         implementation decides the host application's logging for it. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
